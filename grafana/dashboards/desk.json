          "rawSql": "SELECT\n  100.0 * COUNT(*) FILTER (WHERE detected) / NULLIF(COUNT(*), 0) AS \"检测率 %\",\n  100.0 * COUNT(*) FILTER (WHERE ai_correct) / NULLIF(COUNT(*) FILTER (WHERE ai_correct IS NOT NULL), 0) AS \"AI 准确率 %\",\n  100.0 * COUNT(*) FILTER (WHERE baseline_correct) / NULLIF(COUNT(*) FILTER (WHERE detected), 0) AS \"规则准确率 %\",\n  COUNT(*) AS \"故障数\"\nFROM copilot_eval"
