# 复制成 .env 后填上真实的值：cp .env.example .env    （.env 不上传 GitHub）

POSTGRES_PASSWORD=change-me
GRAFANA_PASSWORD=change-me

# Telegram（monitor 发告警用；不填就只写进 alerts 表和日志）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 交易系统速度：1 = 真实速度；想练得快一点可以设成 5（5 倍速）
SPEED=1
# 两次意外之间隔多少分钟（随机）
FAULT_GAP_MIN=20
FAULT_GAP_MAX=60

# AI 值班助手（copilot）。不填 ANTHROPIC_API_KEY 也能跑：只用规则判断，不调用 AI
# key 在 https://console.anthropic.com 申请；只放在服务器的 .env 里，不要提交到 GitHub
ANTHROPIC_API_KEY=
COPILOT_MODEL=claude-sonnet-5-5
COPILOT_DAILY_BUDGET_USD=3
# read = 只调查不建议操作；suggest = 可以建议暂停 PM / 撤单（必须人批准才执行）
COPILOT_AUTONOMY=suggest
